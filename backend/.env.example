# --- Database ---
# Supabase or any PostgreSQL URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/simapi"

# --- Server ---
PORT=4000
# The public URL of your backend (e.g., https://simapi-backend.render.com)
BACKEND_URL=http://localhost:4000

# --- Frontend ---
# The public URL of your frontend (e.g., https://simapi.vercel.app)
FRONTEND_URL=http://localhost:5173

# --- Authentication ---
# Generate a strong secret (e.g., openssl rand -base64 32)
JWT_SECRET="your-very-secret-jwt-key"

# --- OAuth (Google) ---
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- OAuth (GitHub) ---
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
